#!/bin/sh
# Wrapper so OpenChamber can spawn the launcher as $OPENCODE_BINARY.
#
# GUI-launched apps get a minimal environment, so resolve node explicitly
# instead of relying on `#!/usr/bin/env node` finding it on PATH.
set -u

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
PKG_DIR="$SCRIPT_DIR/.."

NODE_BIN="${OCS_NODE_BIN:-${OCMC_NODE_BIN:-}}"
if [ -z "${NODE_BIN:-}" ]; then
  for candidate in \
    "$HOME/.hermes/node/bin/node" \
    "$HOME/.bun/bin/node" \
    "$HOME/.local/bin/node" \
    "/opt/homebrew/bin/node" \
    "/usr/local/bin/node"
  do
    if [ -x "$candidate" ]; then
      NODE_BIN="$candidate"
      break
    fi
  done
fi
if [ -z "${NODE_BIN:-}" ]; then
  NODE_BIN="$(command -v node || true)"
fi
if [ -z "${NODE_BIN:-}" ]; then
  echo "opencode-with-sidecars: node not found (set OCS_NODE_BIN)" >&2
  exit 1
fi

exec "$NODE_BIN" "$PKG_DIR/src/launcher.mjs" "$@"
